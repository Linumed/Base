# Copy to .env and fill in before running `docker compose up -d` in this directory.
# For the Ansible-managed deployment these values come from Vault instead - see
# ansible/roles/bridgelink and docs/roles/bridgelink.md.

BRIDGELINK_ADMIN_PORT=8443
BRIDGELINK_DB_NAME=bridgelink
BRIDGELINK_DB_USER=bridgelink

# Generate once and keep stable for the life of the installation - a changed server ID
# makes BridgeLink treat itself as a different server. `uuidgen`
BRIDGELINK_SERVER_ID=

BRIDGELINK_MAX_HEAP_MB=512

# Passwords are NOT set here. Create ./secrets/mirth.properties and ./secrets/db_password
# as described in the header of docker-compose.yml next to this file - env vars are
# visible via `docker inspect`, secret files are not.
#
# Note the ownership step there: mirth.properties must be chowned to 65532:65532, or the
# hardened container cannot read its own secret and restart-loops while Compose still
# reports the stack as started (issue #61). db_password stays root-owned 0600, because
# the Postgres entrypoint reads it before dropping privileges.
