# Copy to Caddyfile *in this same conf/ directory* (conf/Caddyfile), adjust, then run
# `docker compose up -d` one level up. The compose file mounts this whole directory as
# /etc/caddy, not the single file - see issue #44 for why (a single-file bind mount
# attaches to the inode and stops seeing edits that are saved atomically).
# See docs/roles/caddy.md for the Ansible-managed equivalent (ansible/roles/caddy).
{
	email admin@example.com
}

# host.docker.internal, not 127.0.0.1 - Caddy runs as a container itself, so
# 127.0.0.1 here would mean Caddy, not the Docker host (issue #23). Requires
# extra_hosts: host-gateway, already set in this directory's docker-compose.yml.
example.linumed.local {
	reverse_proxy host.docker.internal:8080
}
