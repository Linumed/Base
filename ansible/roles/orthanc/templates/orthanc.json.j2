{#
  Managed by Ansible (linumed-base, role: orthanc). Do not edit by hand.

  Mounted as a Docker secret, NOT passed as environment variables: this file carries the
  PostgreSQL password and the REST API credentials, and env vars are readable by anyone who
  can run `docker inspect`. Deployed as mode 0400 owned by UID 65532 - a file-based secret
  keeps the host's ownership, and a root-owned file makes the container die in a restart
  loop (the same trap as BridgeLink, issue #61).
#}
{
  "Name": "{{ orthanc_aet }}",
  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db",

  "HttpPort": {{ orthanc_http_port }},
  "DicomPort": {{ orthanc_dicom_port }},
  "DicomAet": "{{ orthanc_aet }}",

  {# The container is reached from another container on the metrics network and through a
     loopback-published port, so "remote" access has to be allowed at Orthanc's level. What
     keeps it private is the port binding and ufw, not this flag. #}
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {
{% for user, password in orthanc_users.items() %}
    "{{ user }}": "{{ password }}"{{ "," if not loop.last }}
{% endfor %}
  },

  {# Deliberately restrictive. Orthanc's own log calls this "the most secure configuration":
     the REST API cannot write to the filesystem and Lua scripts cannot be executed
     remotely. Neither is needed by anything this role deploys. #}
  "RestApiWriteToFileSystemEnabled": false,
  "ExecuteLuaEnabled": false,

  {# No modality is trusted by default. A device that should be able to send here has to be
     listed by the operator - and unknown senders being rejected is the point. #}
  "DicomModalities": {},
  "DicomAlwaysAllowStore": false,
  "DicomCheckCalledAet": false,

  "Plugins": [
{% for plugin in orthanc_plugins %}
    "{{ plugin }}"{{ "," if not loop.last }}
{% endfor %}
  ],

  "PostgreSQL": {
    "EnableIndex": true,
    "EnableStorage": {{ orthanc_postgres_enable_storage | bool | lower }},
    "Host": "orthanc-db",
    "Port": 5432,
    "Database": "{{ orthanc_db_name }}",
    "Username": "{{ orthanc_db_user }}",
    "Password": "{{ orthanc_db_password }}"
  }
}
