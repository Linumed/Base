# Managed by Ansible (linumed-base, role: orthanc). Do not edit by hand, changes will be
# overwritten.
services:
  orthanc:
    image: {{ orthanc_image }}
    container_name: linumed-base-orthanc
    restart: unless-stopped
    # Orthanc finishes in-flight jobs and closes its database connections on shutdown;
    # Docker's default 10s can cut that short mid-transfer.
    stop_grace_period: {{ orthanc_stop_grace_period }}s
    security_opt:
      - no-new-privileges:true
    # Unprivileged, which is the whole reason this image was chosen over orthancteam's -
    # that one cannot do it (ADR 0009). The component holding DICOM data is the last place
    # this kit would accept a root container.
    user: "{{ orthanc_uid }}:{{ orthanc_gid }}"
    # The config is a Docker secret, so it lands at /run/secrets/<name>, not at a path of
    # our choosing - Orthanc takes its config file as an argument, which makes that fine.
    command: ["/run/secrets/orthanc_config"]
    secrets:
      - orthanc_config
    # Loopback only - the REST API and Explorer are reached through an SSH tunnel.
    ports:
      - "127.0.0.1:{{ orthanc_http_port }}:{{ orthanc_http_port }}"
{% if orthanc_publish_dicom_port | bool %}
      # Published deliberately by the operator: modalities have to reach it. Note this
      # bypasses ufw, and what arrives here is patient data - see docs/roles/orthanc.md.
      - "{{ orthanc_dicom_port }}:{{ orthanc_dicom_port }}"
{% endif %}
    volumes:
      - orthanc_storage:/var/lib/orthanc/db
{% if orthanc_metrics_enabled | bool %}
    networks:
      - default
      - {{ orthanc_metrics_network }}
{% endif %}
    # No curl or wget in the image, but bash is present - so the check speaks raw HTTP over
    # /dev/tcp, the same technique the monitoring role uses for Alloy, and for the same two
    # reasons its comment records:
    #
    #   * `CMD` with an explicit `bash`, never `CMD-SHELL`. CMD-SHELL runs /bin/sh, which on
    #     this image is dash, and /dev/tcp is a bash feature - the first version of this
    #     check used CMD-SHELL and every probe failed with "cannot create
    #     /dev/tcp/127.0.0.1/8042: Directory nonexistent" until it was actually run.
    #   * Single-quoted YAML, not double: a double-quoted scalar turns \r\n into real
    #     control characters at parse time, before Compose sees it.
    #
    # 401 counts as alive on purpose: an unauthenticated request proves the HTTP server is
    # serving, which is what a liveness check is for. Checking credentials here would turn a
    # wrong password into an unhealthy container instead of a clear 401 in the logs.
    healthcheck:
      test: ['CMD', 'bash', '-c', 'exec 3<>/dev/tcp/127.0.0.1/{{ orthanc_http_port }} && printf ''GET /system HTTP/1.0\r\n\r\n'' >&3 && head -1 <&3 | grep -qE "40[13]|200"']
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    depends_on:
      orthanc-db:
        condition: service_healthy

  orthanc-db:
    image: {{ orthanc_postgres_image }}
    container_name: linumed-base-orthanc-db
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      POSTGRES_DB: "{{ orthanc_db_name }}"
      POSTGRES_USER: "{{ orthanc_db_user }}"
      POSTGRES_PASSWORD_FILE: /run/secrets/orthanc_db_password
    secrets:
      - orthanc_db_password
    # No published port at all - only Orthanc talks to it, over this stack's own network.
    volumes:
      - orthanc_db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ orthanc_db_user }} -d {{ orthanc_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

secrets:
  orthanc_config:
    file: ./secrets/orthanc.json
  orthanc_db_password:
    file: ./secrets/db_password

{% if orthanc_metrics_enabled | bool %}
networks:
  # Created by the monitoring role, joined here - hence external. Consequence: with metrics
  # enabled, the monitoring role must have run on this host first (#64).
  {{ orthanc_metrics_network }}:
    external: true
    name: {{ orthanc_metrics_network }}
{% endif %}

volumes:
  orthanc_storage:
  orthanc_db_data:
