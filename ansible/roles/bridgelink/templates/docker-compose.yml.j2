# Managed by Ansible (linumed-base, role: bridgelink). Do not edit by hand, changes will be
# overwritten. Deliberately close to docker/bridgelink/docker-compose.yml (the
# manual-testing reference), but this one is driven by Ansible variables instead of a
# .env file - keep both in sync when bumping bridgelink_image.
services:
  bridgelink:
    image: {{ bridgelink_image }}
    container_name: linumed-base-bridgelink
    restart: unless-stopped
    # Upstream's launcher drains queues and DB connections for up to 30s on shutdown;
    # Docker's default 10s would cut that short and risk losing in-flight messages.
    stop_grace_period: {{ bridgelink_stop_grace_period }}s
    security_opt:
      - no-new-privileges:true
    environment:
      MP_DATABASE: "postgres"
      MP_DATABASE_URL: "jdbc:postgresql://bridgelink-db:5432/{{ bridgelink_db_name }}"
      MP_DATABASE_USERNAME: "{{ bridgelink_db_user }}"
      # database.password, keystore.storepass and keystore.keypass deliberately come from
      # the mirth_properties secret below, not from here - env vars show up in
      # `docker inspect` and in the container config on disk.
      MP_DATABASE_MAX__CONNECTIONS: "20"
      MP_DATABASE_MAX_RETRY: "5"
      MP_DATABASE_RETRY_WAIT: "10000"
      MP_VMOPTIONS: "{{ bridgelink_max_heap_mb }}"
      SERVER_ID: "{{ bridgelink_server_id }}"
    secrets:
      - mirth_properties
    # Loopback only. A published container port bypasses ufw (see the common role's ufw
    # docs), so only what genuinely needs to be reachable gets published - and the admin
    # API is reached through an SSH tunnel, not from the network.
    ports:
      - "127.0.0.1:{{ bridgelink_admin_port }}:8443"
    volumes:
      - bridgelink_appdata:/opt/bridgelink/appdata
      - bridgelink_extensions:/opt/bridgelink/custom-extensions
    # No HEALTHCHECK: the -dhi image is a hardened Docker Hardened Image with no shell and
    # no package manager - there is no wget/curl/sh an exec-form healthcheck could run
    # (same situation as grafana/loki in the monitoring role). Functional health is
    # verified externally instead, see docs/roles/bridgelink.md.
    depends_on:
      bridgelink-db:
        condition: service_healthy

  bridgelink-db:
    image: {{ bridgelink_postgres_image }}
    container_name: linumed-base-bridgelink-db
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      POSTGRES_DB: "{{ bridgelink_db_name }}"
      POSTGRES_USER: "{{ bridgelink_db_user }}"
      POSTGRES_PASSWORD_FILE: /run/secrets/db_password
    secrets:
      - db_password
    # No published port at all - only BridgeLink talks to it, over this stack's network.
    volumes:
      - bridgelink_db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ bridgelink_db_user }} -d {{ bridgelink_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

{% if bridgelink_exporter_enabled %}
  # Prometheus exporter for channel statistics (issue #60). BridgeLink itself serves no
  # /metrics, so without this Prometheus sees only cAdvisor's container CPU/RAM for it and
  # a stopped channel or a filling queue stays invisible.
  bridgelink-exporter:
    image: {{ bridgelink_exporter_image }}
    container_name: linumed-base-bridgelink-exporter
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    # The pinned upstream python image runs as root by default; nothing here needs it.
    user: "{{ bridgelink_uid }}:{{ bridgelink_gid }}"
    command: ["python", "/opt/exporter/bridgelink_exporter.py"]
    environment:
      # Service name on this stack's network - the exporter does not go through the
      # published loopback port.
      BRIDGELINK_URL: "https://bridgelink:8443"
      BRIDGELINK_EXPORTER_USER: "{{ bridgelink_exporter_user }}"
      # Password comes from the secret file below, never from an env var - `docker inspect`
      # would show it otherwise.
      BRIDGELINK_EXPORTER_PASSWORD_FILE: /run/secrets/exporter_password
      BRIDGELINK_EXPORTER_PORT: "9151"
      BRIDGELINK_EXPORTER_VERIFY_TLS: "{{ bridgelink_exporter_verify_tls | string | lower }}"
    secrets:
      - exporter_password
    # Read-only bind mount of a repo-managed script - the documented exception to
    # CONVENTIONS.md's "named volumes only", and the reason no image has to be built here.
    volumes:
      - {{ bridgelink_deploy_dir }}/bridgelink_exporter.py:/opt/exporter/bridgelink_exporter.py:ro
    ports:
      - "127.0.0.1:{{ bridgelink_exporter_port }}:9151"
    # /healthz reports the exporter's own liveness and deliberately not BridgeLink's - a
    # down engine must not restart the exporter, or the up=0 metric that says so
    # disappears exactly when it is needed. busybox wget, present in the alpine image.
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:9151/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    depends_on:
      - bridgelink
{% endif %}

secrets:
  mirth_properties:
    file: ./secrets/mirth.properties
{% if bridgelink_exporter_enabled %}
  exporter_password:
    file: ./secrets/exporter_password
{% endif %}
  db_password:
    file: ./secrets/db_password

volumes:
  bridgelink_appdata:
  bridgelink_extensions:
  bridgelink_db_data:
