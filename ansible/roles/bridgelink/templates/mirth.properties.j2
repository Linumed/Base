{#
  Managed by Ansible (linumed-base, role: bridgelink). Do not edit by hand.

  Mounted into the container as the `mirth_properties` Docker secret (at
  /run/secrets/mirth_properties), NOT passed as environment variables: env vars are
  visible to anyone who can run `docker inspect` and end up in the container's config
  JSON on disk. Everything in this file gets merged into mirth.properties at startup.
  Deployed as mode 0400 owned by UID 65532 (bridgelink_uid), NOT root: a file-based
  Docker secret keeps the host's ownership when Compose mounts it, and the -dhi image
  runs unprivileged, so a root-owned file makes the bootstrap die with
  AccessDeniedException in a restart loop. See tasks/main.yml and issue #61.
#}
database.password = {{ bridgelink_db_password }}
keystore.storepass = {{ bridgelink_keystore_storepass }}
keystore.keypass = {{ bridgelink_keystore_keypass }}
