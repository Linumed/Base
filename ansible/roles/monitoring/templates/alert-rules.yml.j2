# Managed by Ansible (linumed-base, role: monitoring). Do not edit by hand, changes will be
# overwritten.
groups:
  - name: linumed-base-host
    rules:
      - alert: HostDown
        expr: up == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{ $labels.job }}' }} target down on {{ '{{ $labels.instance }}' }}"
          description: >-
            Prometheus has not been able to scrape {{ '{{ $labels.job }}' }} at
            {{ '{{ $labels.instance }}' }} for 5 minutes.

      - alert: DiskSpaceLow
        expr: >-
          100 * (1 - (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"})) > 85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Root filesystem above 85% used"
          description: >-
            {{ '{{ $value | printf "%.1f" }}' }}% of the root filesystem is in use on
            {{ '{{ $labels.instance }}' }}.

      - alert: MemoryLow
        expr: >-
          100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Memory usage above 90%"
          description: >-
            {{ '{{ $value | printf "%.1f" }}' }}% of memory is in use on
            {{ '{{ $labels.instance }}' }}.

  - name: linumed-base-containers
    rules:
      # container_start_time_seconds changing repeatedly means the container keeps
      # restarting - cAdvisor doesn't expose a direct restart counter, so the start
      # timestamp changing is the proxy signal.
      - alert: ContainerRestartLoop
        expr: changes(container_start_time_seconds{name!=""}[15m]) > 3
        labels:
          severity: warning
        annotations:
          summary: "Container {{ '{{ $labels.name }}' }} is restarting repeatedly"
          description: >-
            {{ '{{ $labels.name }}' }} has restarted more than 3 times in the last 15
            minutes.

  - name: linumed-base-backup
    rules:
      # Dormant until the backup role (#7) exports backup_last_success_timestamp_seconds -
      # an absent metric simply produces no series, so this rule never fires and never
      # errors in the meantime. Activates automatically once #7 lands, no change needed
      # here.
      - alert: BackupStale
        expr: time() - backup_last_success_timestamp_seconds > 90000
        labels:
          severity: warning
        annotations:
          summary: "No successful backup in over 25 hours"
          description: >-
            The last successful restic backup on {{ '{{ $labels.instance }}' }} was more
            than 25 hours ago.

      # Same dormant-until-the-metric-exists pattern as BackupStale - restore_test_success
      # only appears once the backup role's restore-test timer (#36) has run at least
      # once. Fires on the first failed run, not after a delay: unlike a stale metric, a
      # restore test that ran and produced a real diff is worth knowing about
      # immediately, not after a grace period.
      - alert: RestoreTestFailed
        expr: restore_test_success == 0
        labels:
          severity: critical
        annotations:
          summary: "Backup restore test failed on {{ '{{ $labels.instance }}' }}"
          description: >-
            The last restore test on {{ '{{ $labels.instance }}' }} either failed to
            restore or the restored data did not match the source
            ({{ '{{ $labels.instance }}' }}: restore_test_diff_lines > 0). Treat the
            underlying backup as unverified until this is investigated.

      # Weekly schedule by default (backup_restore_test_schedule), so the threshold is a
      # multiple of a week, not a day like BackupStale - 9 days allows one missed run
      # (e.g. a reboot during the scheduled window) before paging, matching
      # RandomizedDelaySec and Persistent=true already giving the timer room to catch up
      # on its own first.
      - alert: RestoreTestStale
        expr: time() - restore_test_last_success_timestamp_seconds > 777600
        labels:
          severity: warning
        annotations:
          summary: "No successful restore test in over 9 days"
          description: >-
            The last successful backup restore test on {{ '{{ $labels.instance }}' }} was
            more than 9 days ago - the weekly schedule expects one every 7.

  # Same dormant-until-the-metric-exists pattern as the backup rules above: with the
  # bridgelink exporter switched off these expressions match no series, so they never fire
  # and never error. They activate on their own once bridgelink_exporter_enabled and
  # monitoring_scrape_bridgelink are both on (issue #60).
  - name: linumed-base-bridgelink
    rules:
      - alert: BridgeLinkDown
        # The exporter answers with bridgelink_up 0 rather than failing the scrape, so
        # this stays distinguishable from "the exporter itself is gone" (HostDown).
        expr: bridgelink_up == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "BridgeLink API not answering"
          description: >-
            The exporter has been unable to query the BridgeLink API for 5 minutes.
            Message routing is likely down.

      # The failure this whole exporter exists for: a channel that is deployed but not
      # running. cAdvisor cannot see this - the container is healthy, the CPU is idle, and
      # messages silently stop being processed.
      - alert: BridgeLinkChannelNotStarted
        expr: bridgelink_channel_state{state="STARTED"} == 0 and on(channel_id) bridgelink_channel_state{state="UNDEPLOYED"} == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Channel {{ '{{ $labels.channel }}' }} is deployed but not started"
          description: >-
            {{ '{{ $labels.channel }}' }} has not been in STARTED state for 10 minutes.

      - alert: BridgeLinkConnectorNotStarted
        expr: bridgelink_connector_state{state="STOPPED"} == 1
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: >-
            Connector {{ '{{ $labels.connector }}' }} on {{ '{{ $labels.channel }}' }}
            is stopped
          description: >-
            A stopped destination connector means messages reach the channel but are not
            delivered onwards.

      # Absolute threshold rather than a rate: a queue that is draining slowly is normal,
      # a queue this deep is not, whatever its trend.
      - alert: BridgeLinkQueueBacklog
        expr: bridgelink_connector_queued_messages > 1000
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: >-
            {{ '{{ $value }}' }} messages queued on {{ '{{ $labels.connector }}' }}
            ({{ '{{ $labels.channel }}' }})
          description: >-
            The destination has been unable to drain its queue for 15 minutes - the
            receiving system is usually the cause.

      - alert: BridgeLinkErrorRate
        # increase() over 15m, not the raw counter: lifetime error totals only grow, so a
        # threshold on the counter itself would latch on forever after a single bad day.
        expr: increase(bridgelink_channel_messages_total{status="error"}[15m]) > 10
        labels:
          severity: warning
        annotations:
          summary: >-
            {{ '{{ $labels.channel }}' }} produced
            {{ '{{ $value | printf "%.0f" }}' }} errors in 15 minutes
          description: >-
            Messages are failing in the channel's filter, transformer or destination.

      # -Xmx is bridgelink_max_heap_mb (512 MB by default), which is easy to outgrow once
      # real channels with attachments run. cAdvisor shows the JVM's RSS, which says
      # nothing about how close the heap is to its ceiling.
      - alert: BridgeLinkHeapHigh
        expr: >-
          (bridgelink_jvm_memory_allocated_bytes - bridgelink_jvm_memory_free_bytes)
          / bridgelink_jvm_memory_max_bytes > 0.9
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "BridgeLink JVM heap above 90% of its ceiling"
          description: >-
            Raise bridgelink_max_heap_mb or reduce channel throughput; an exhausted heap
            makes the engine stall rather than crash cleanly.
