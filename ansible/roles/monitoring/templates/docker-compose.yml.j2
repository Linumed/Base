# Managed by Ansible (linumed-base, role: monitoring). Do not edit by hand, changes will be
# overwritten. Services are added incrementally as the role grows (Prometheus first,
# Loki/Alloy/Grafana/Alertmanager/cAdvisor follow) - each verified against a real target
# before the next is added.
services:
  loki:
    image: {{ monitoring_loki_image }}
    container_name: linumed-base-loki
    restart: unless-stopped
    # No published port - only Alloy and Grafana (added later) reach it, both inside this
    # same Compose network, by service name.
    command: -config.file=/etc/loki/loki-config.yml
    volumes:
      - ./loki-config.yml:/etc/loki/loki-config.yml:ro
      - loki_data:/loki
    # No HEALTHCHECK: grafana/loki is a minimal image with no shell, wget, or any other
    # executable besides the loki binary itself (confirmed 2026-08-10 - `docker exec`
    # fails on wget, sh, even ls) - there is no command an exec-form healthcheck could
    # run. Functional health is verified externally instead (see docs/roles/monitoring.md
    # verification section: a real query against /loki/api/v1/query_range).

  # Sits between Alloy and the real Docker socket (#21). Mounts the socket read-only and
  # only forwards GET /containers* (container list + log streaming) and GET /networks
  # (discovery.docker also queries network labels per container, confirmed against a real
  # Alloy - without NETWORKS it 403s) - no exec, no build, no volumes/secrets, no POST at
  # all. No published port, reached by Alloy only via the service name inside this
  # stack's Compose network.
  docker-socket-proxy:
    image: {{ monitoring_docker_socket_proxy_image }}
    container_name: linumed-base-docker-socket-proxy
    restart: unless-stopped
    environment:
      CONTAINERS: "1"
      NETWORKS: "1"
      POST: "0"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    # /_ping is Docker's own liveness endpoint, forwarded even without explicitly setting
    # PING=1 - confirmed against a real container (curling /_ping through a proxy with
    # only CONTAINERS/NETWORKS/POST set still returns 200). No CONTAINERS/NETWORKS scope
    # needed for this path, so it can't be used to smuggle extra access through the
    # healthcheck.
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:2375/_ping"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  alloy:
    image: {{ monitoring_alloy_image }}
    container_name: linumed-base-alloy
    restart: unless-stopped
    command:
      - run
      - --stability.level=generally-available
      - /etc/alloy/config.alloy
    # No Docker socket here at all - Alloy only ever talks to docker-socket-proxy over the
    # Compose network. group_add is the journal group's GID on THIS host (looked up at
    # play time, not hardcoded - it varies per machine, same caveat as the docker group
    # GID in the Forgejo runner setup) so Alloy can read /var/log/journal without running
    # as root.
    group_add:
      - "{{ monitoring_journal_gid }}"
    volumes:
      - ./alloy-config.alloy:/etc/alloy/config.alloy:ro
      - /var/log/journal:/var/log/journal:ro
      - /etc/machine-id:/etc/machine-id:ro
    # No wget or curl in this image (confirmed: full Debian base with coreutils, but
    # neither installed) - unlike Loki this one does have a shell, so bash's /dev/tcp
    # pseudo-device stands in for them (confirmed against a real container: a raw HTTP/1.0
    # GET over /dev/tcp against Alloy's own debug UI on 127.0.0.1:12345, its default
    # listen address, returns "HTTP/1.0 200 OK"). No dedicated /-/ready path is documented
    # for this version; the debug UI root responding is a legitimate liveness signal even
    # so - Alloy would not serve it while still starting up or wedged.
    #
    # Single-quoted YAML here, not double - confirmed the hard way: a double-quoted YAML
    # scalar interprets \r\n as real control characters at parse time, before docker
    # compose ever sees it, collapsing the whole sequence and breaking the command it's
    # embedded in. Single-quoted YAML passes the backslash-r-backslash-n through literally
    # to bash, which is what printf needs to interpret them itself.
    healthcheck:
      test: ['CMD', 'bash', '-c', 'exec 3<>/dev/tcp/127.0.0.1/12345 && printf ''GET / HTTP/1.0\r\n\r\n'' >&3 && head -1 <&3 | grep -q 200']
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    depends_on:
      - loki
      - docker-socket-proxy

  alertmanager:
    image: {{ monitoring_alertmanager_image }}
    container_name: linumed-base-alertmanager
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
    # No published port - Prometheus reaches it by service name inside this stack's
    # Compose network. No delivery configured yet either (see alertmanager.yml.j2) - #22.
    volumes:
      - ./alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager_data:/alertmanager
    # /-/healthy is the same convention Prometheus itself uses (see prometheus's own
    # healthcheck below) - confirmed against a real container.
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:9093/-/healthy"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  cadvisor:
    image: {{ monitoring_cadvisor_image }}
    container_name: linumed-base-cadvisor
    restart: unless-stopped
    # No published port - only Prometheus scrapes it, by service name inside this stack's
    # Compose network. Standard cAdvisor mounts, no --privileged needed on Debian (that's
    # only required on CentOS/RHEL/Fedora per upstream docs).
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:rw
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
    # /healthz confirmed against a real container: returns "ok" with HTTP 200.
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  grafana:
    image: {{ monitoring_grafana_image }}
    container_name: linumed-base-grafana
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: "{{ monitoring_grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ monitoring_grafana_admin_password }}"
      # Telemetry off - matches CONVENTIONS.md's "no phone-home telemetry" principle. Grafana
      # phones home by default otherwise (usage stats, update checks).
      GF_ANALYTICS_REPORTING_ENABLED: "{{ monitoring_grafana_reporting_enabled | string | lower }}"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "{{ monitoring_grafana_check_for_updates | string | lower }}"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "{{ monitoring_grafana_check_for_updates | string | lower }}"
      GF_ANALYTICS_FEEDBACK_LINKS_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
{% if monitoring_grafana_oidc_client_id %}
      # OIDC as a connection point to an EXISTING identity provider (issue #42, ADR
      # 0003) - not a bundled one. Empty client_id above means this whole block is
      # skipped and nothing about auth changes.
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: "{{ monitoring_grafana_oidc_name }}"
      GF_AUTH_GENERIC_OAUTH_CLIENT_ID: "{{ monitoring_grafana_oidc_client_id }}"
      GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: "{{ monitoring_grafana_oidc_client_secret }}"
      GF_AUTH_GENERIC_OAUTH_SCOPES: "{{ monitoring_grafana_oidc_scopes }}"
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: "{{ monitoring_grafana_oidc_auth_url }}"
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: "{{ monitoring_grafana_oidc_token_url }}"
      GF_AUTH_GENERIC_OAUTH_API_URL: "{{ monitoring_grafana_oidc_api_url }}"
      GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP: "{{ monitoring_grafana_oidc_allow_sign_up | string | lower }}"
{% endif %}
    ports:
      - "127.0.0.1:{{ monitoring_grafana_port }}:3000"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - grafana_data:/var/lib/grafana
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:3000/api/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    depends_on:
      - prometheus
      - loki
  prometheus:
    image: {{ monitoring_prometheus_image }}
    container_name: linumed-base-prometheus
    restart: unless-stopped
    # --web.enable-lifecycle: needed for the "Reload prometheus" handler's /-/reload call.
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ (monitoring_retention_days | default(monitoring_metrics_retention_days, true)) }}d
      - --storage.tsdb.retention.size={{ monitoring_prometheus_retention_size }}
      - --web.enable-lifecycle
    # Container can't reach the host's 127.0.0.1 - host-gateway resolves
    # host.docker.internal to the host, which Node Exporter listens on (see
    # defaults/main.yml for why Node Exporter isn't loopback-only).
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "127.0.0.1:{{ monitoring_prometheus_port }}:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./alert-rules.yml:/etc/prometheus/alert-rules.yml:ro
      - prometheus_data:/prometheus
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:9090/-/healthy"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

volumes:
  prometheus_data:
  loki_data:
  grafana_data:
  alertmanager_data:
