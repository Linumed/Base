# Managed by Ansible (linumed-base, role: caddy). Do not edit by hand, changes will be overwritten.
# Deliberately close to docker/caddy/docker-compose.yml (the manual-testing reference) but
# not identical - this one uses Ansible variables instead of a .env file, since the role
# already owns config generation end to end. Keep both in sync when bumping caddy_image.
services:
  caddy:
    image: {{ caddy_image }}
    # Fixed name, not left to compose's default project-derived naming - the "Reload caddy"
    # handler execs into this container by name and needs a stable target.
    container_name: linumed-base-caddy
    restart: unless-stopped
    # A container can't reach the host's own 127.0.0.1 - host-gateway resolves
    # host.docker.internal to the host, for reverse_proxy targets that run natively on
    # the host rather than in another container (see caddy_sites example in
    # defaults/main.yml - issue #23).
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "{{ caddy_http_port }}:80"
      - "{{ caddy_https_port }}:443"
    volumes:
      # Directory mount, not a single-file mount - a single-file bind mount attaches to
      # the file's inode at container start, and Ansible's template module rewrites
      # atomically (temp file + rename). After the first Caddyfile change post-deploy,
      # a single-file mount would keep serving the original inode forever - "caddy
      # reload" succeeds and the healthcheck stays green, but the config never actually
      # updates. Confirmed and fixed as issue #44. The directory mount follows the
      # directory entry instead, so the rename is visible.
      - ./conf:/etc/caddy:ro
      - caddy_data:/data
      - caddy_config:/config
    # "default" has to be listed explicitly, not left implicit - once a service defines
    # networks: at all, Compose stops attaching it to the project's own default network
    # automatically. Nothing else lives on it today, but silently dropping Caddy off its
    # own project network the moment this role adds a second one would be a surprising
    # side effect of an unrelated change - keep the existing topology, add to it.
    networks:
      - default
      - {{ caddy_external_network_name }}
    healthcheck:
      # 127.0.0.1, not localhost - Caddy's admin API only binds the IPv4 loopback, and
      # "localhost" resolves to ::1 first inside the container, which wget then can't
      # reach (confirmed 2026-08-08: healthcheck stuck at "starting" with "Connection
      # refused" until switched to the literal IP).
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:2019/config/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

volumes:
  caddy_data:
  caddy_config:

networks:
  # explicit `name:`, not left to Compose's default "<project>_<key>" derivation - an
  # operator's own, entirely separate Compose stack has to reference this network by a
  # name that's stable regardless of what this stack's project name happens to be (issue
  # #39). See docs/roles/caddy.md for the operator-facing side: their compose file joins
  # this same name as `external: true`.
  {{ caddy_external_network_name }}:
    name: {{ caddy_external_network_name }}
