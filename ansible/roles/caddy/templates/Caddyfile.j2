# Managed by Ansible (linumed-base, role: caddy). Do not edit by hand, changes will be overwritten.
{
{% if caddy_email %}
	email {{ caddy_email }}
{% endif %}
}

{% for site in caddy_sites %}
{{ site.domain }} {
	reverse_proxy {{ site.reverse_proxy }}
{% if site.extra is defined and site.extra %}
	{{ site.extra }}
{% endif %}
}
{% endfor %}
