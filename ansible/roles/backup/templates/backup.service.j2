[Unit]
Description=Linumed Base backup (restic)

[Service]
Type=oneshot
# Without this, restic in a systemd context finds no $XDG_CACHE_HOME or $HOME and rebuilds
# its local metadata cache from scratch on every single run instead of reusing it -
# harmless but slow, confirmed against a hand-rolled backup service before this role.
Environment=HOME=/root
ExecStart=/usr/local/bin/linumed-base-backup.sh
