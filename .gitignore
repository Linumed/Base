# Ansible
*.retry
ansible/inventory/*/hosts.yml
ansible/inventory/*/group_vars/
!ansible/inventory/example/
*.vault
.vault_pass
vault_password_file

# Environment files
.env
*.env
!*.env.example

# Vagrant
.vagrant/
*.box

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Secrets - never commit these
*_password
*_secret
*_token
*_key
# Docker secret files are created locally at runtime (docker/<stack>/secrets/) and hold
# plain-text credentials - the whole directory stays out of the repo.
docker/*/secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_ed25519

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# MkDocs
site/

# Logs
*.log
